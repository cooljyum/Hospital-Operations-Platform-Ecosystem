# docker compose가 참조하는 환경변수 예시.
# 사용법: 이 파일을 같은 디렉터리에 `.env`로 복사한 뒤 실제 값으로 채운다.
#   cp docker/.env.example docker/.env
# `.env`는 git에 커밋하지 않는다(비밀번호 등 실값이 들어가므로).

# --- MySQL ---
DB_NAME=hospital_ops
DB_USERNAME=hospital_ops
DB_PASSWORD=changeme
DB_ROOT_PASSWORD=changeme_root

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme_admin
