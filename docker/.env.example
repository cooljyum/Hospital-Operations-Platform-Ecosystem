# docker compose가 참조하는 환경변수 예시.
# 사용법: 이 파일을 같은 디렉터리에 `.env`로 복사한 뒤 실제 값으로 채운다.
#   cp docker/.env.example docker/.env
# `.env`는 git에 커밋하지 않는다(비밀번호 등 실값이 들어가므로).

# --- MySQL ---
DB_NAME=hospital_ops
DB_USERNAME=hospital_ops
DB_PASSWORD=changeme
DB_ROOT_PASSWORD=changeme_root

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme_admin

# --- App crypto ---
# ENVELOPE_KEK: Base64 인코딩된 32바이트 키. 비워두면 EnvelopeCrypto가 기동 시점에
# IllegalStateException을 던져 앱 컨테이너가 뜨지 않는다(의도된 fail-fast).
# 실제 비밀값을 이 예시 파일에 커밋하지 말 것 — 아래 명령으로 로컬용 키를 직접 생성해 `.env`에만 넣는다.
#   macOS/Linux: openssl rand -base64 32
#   PowerShell : [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
# ENVELOPE_KEK=
